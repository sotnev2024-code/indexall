# Порт сервера
PORT=4000

# База данных
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=indexall

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Режим
NODE_ENV=development

# ЮКасса (YuKassa) — получите в личном кабинете https://yookassa.ru/my
YUKASSA_SHOP_ID=your-shop-id
YUKASSA_SECRET_KEY=your-secret-key

# URL фронтенда (для редиректа после оплаты и ссылок в письмах)
FRONTEND_URL=http://localhost:3000

# SMTP для отправки писем — укажи параметры своего провайдера.
# Если SMTP_HOST/PORT/SECURE не заданы — используется smtp.yandex.ru:465 SSL.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-app-password

# Секрет для Telegram бота (произвольная строка)
BOT_SECRET=your-bot-secret-key

# ── Социальные логины (OAuth) ───────────────────────────────────────────────
# Получите credentials в консолях разработчика каждой платформы.
# APP_URL — URL бэкенда (используется для формирования callback URL)
APP_URL=https://indexall.nkubot.ru

# Google: https://console.cloud.google.com/
# Redirect URI: ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Яндекс: https://oauth.yandex.ru/
# Redirect URI: ${APP_URL}/api/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Mail.ru: https://api.mail.ru/oauth/
# Redirect URI: ${APP_URL}/api/auth/oauth/mailru/callback
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# Путь к SQLite-базе Telegram-бота для раздела "Подбор по категориям"
# Локально (разработка):
# BOT_DB_PATH=C:/Users/sotne/Desktop/files — копия/bot_database.db
# На VPS (после деплоя укажите абсолютный путь):
# BOT_DB_PATH=/home/user/bot/bot_database.db
