PORT=4000
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_NAME=indexall
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_EXPIRES_IN=7d
NODE_ENV=production
FRONTEND_URL=http://7150079-fv25894.twc1.net
# SMTP — укажи настройки своего почтового провайдера.
# Значения по умолчанию (если закомментированы): smtp.yandex.ru, порт 465, SSL.
#
# reg.ru (почта на хостинге):
#   SMTP_HOST=mail.hosting.reg.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
#
# Яндекс 360 для бизнеса / личный Яндекс:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
#
# Mail.ru:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@indexall.ru
SMTP_PASS=YOUR_MAILBOX_PASSWORD
BOT_DB_PATH=/opt/bot_database.db
YUKASSA_SHOP_ID=YOUR_SHOP_ID
YUKASSA_SECRET_KEY=YOUR_SECRET_KEY
# Код ставки НДС для фискальных чеков (54-ФЗ через «Чеки от ЮKassa»).
# 1 — без НДС (по умолчанию, ИП/самозанятые на УСН)
# 2 — НДС 0%      3 — НДС 10%      4 — НДС 20%
# 5 — НДС 10/110  6 — НДС 20/120
YOOKASSA_VAT_CODE=1
# Код системы налогообложения. Заполнять только если ЮKassa требует явного
# указания (у магазина настроены несколько систем) или возвращает ошибку
# «Receipt is missing or illegal». Иначе оставить пустым — будет использована
# система из ЛК.
# 1 — ОСН       2 — УСН доходы        3 — УСН доходы-расходы
# 4 — ЕСН       5 — ПСН               6 — Самозанятый
# YOOKASSA_TAX_SYSTEM_CODE=2
