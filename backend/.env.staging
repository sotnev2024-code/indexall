# ── Staging backend environment ──────────────────────────────────────────────
# Copy this file to the server at /opt/indexall-staging/backend/.env.staging
# and fill in real values where marked with TODO.

NODE_ENV=production
PORT=4001

# Database — staging has its own DB on port 5433
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=indexall_staging
DB_PASSWORD=postgres

# JWT — use a DIFFERENT secret from production!
JWT_SECRET=staging_jwt_secret_change_me_TODO

# Frontend URL for CORS and email links
FRONTEND_URL=https://STAGING_DOMAIN_HERE

# YooKassa — use test credentials for staging
YUKASSA_SHOP_ID=TODO_test_shop_id
YUKASSA_SECRET_KEY=TODO_test_secret_key

# ETM API (can share with production for testing)
ETM_LOGIN=TODO
ETM_PASSWORD=TODO

# Email (can share with production or use a separate test mailbox)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=TODO
MAIL_PASS=TODO
MAIL_FROM=TODO

# Misc
YOOKASSA_VAT_CODE=1
